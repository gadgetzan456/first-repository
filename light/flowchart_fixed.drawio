        <mxCell id="f-b22" value="&lt;b&gt;10ms タイマ割り込み&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="940" y="270" width="760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f-b23" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="940" y="310" width="760" height="2350" as="geometry" />
        </mxCell>
        <mxCell id="f-b24" value="割り込みは main の&lt;br&gt;どの処理の途中でも&lt;br&gt;10ms ごとに入り、&lt;br&gt;終わると main の&lt;br&gt;続きに戻る" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="770" y="325" width="160" height="100" as="geometry" />
