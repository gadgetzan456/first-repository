        </mxCell>
        <mxCell id="f-i_clr" value="割り込み要因フラグをクリア&lt;br&gt;（必要なマイコンのみ）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1200.0" y="410" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f-i_read" value="sw = スイッチ入力ポートの値&lt;br&gt;（押下 = 1 に揃える）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1200.0" y="490" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f-i_d1" value="sw == sw_state?&lt;br&gt;（確定状態と同じ）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="570" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f-i_c0" value="sw_cnt = 0" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1490.0" y="590" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f-i_cinc" value="sw_cnt++" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="690" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f-i_d2" value="sw_cnt &gt;= 3?&lt;br&gt;（3回連続で違う）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="770" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f-i_fix" value="sw_cnt = 0&lt;br&gt;sw_state = sw（確定）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="890" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f-i_d3" value="sw_state == 1?&lt;br&gt;（押された）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="990" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f-i_p0" value="press_time = 0&lt;br&gt;long_done = 0" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="980.0" y="1100" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f-i_d4" value="long_done == 0?&lt;br&gt;（3秒未満で離した）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="1110" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f-i_d5" value="mode == 0?&lt;br&gt;（短押し有効）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="1230" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f-i_sinc" value="short_cnt++" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="1350" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f-i_d6" value="short_cnt &gt;= 2?" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="1430" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f-i_sflag" value="short_cnt = 0&lt;br&gt;short_flag = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="1550" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f-i_d7" value="sw_state == 1 かつ&lt;br&gt;long_done == 0?&lt;br&gt;（押している最中）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1210.0" y="1670" width="240" height="90" as="geometry" />
