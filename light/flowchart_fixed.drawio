        <mxCell id="s-e6" value="短押し2回&lt;br&gt;LED3 を消してすぐ点滅&lt;br&gt;（消灯から開始）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-n-l3" target="s-n-bl">
          <mxGeometry relative="1" as="geometry" x="0.3">
            <Array as="points">
