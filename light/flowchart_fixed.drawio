  </diagram>
  <diagram name="10ms割り込み" id="page-1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s-start" value="10ms 割り込み" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="340.0" y="20" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s-read" value="sw = スイッチの入力" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="100" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s-d1" value="sw == sw_state?&lt;br&gt;（確定状態と同じ？）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="180" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s-c0" value="sw_cnt = 0" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="660.0" y="200" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s-cinc" value="sw_cnt++" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="300" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s-d2" value="sw_cnt &gt;= 3?&lt;br&gt;（3回連続で違う）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="380" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s-fix" value="sw_cnt = 0&lt;br&gt;sw_state = sw" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="500" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s-d3" value="sw_state == 1?&lt;br&gt;（押された？）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="600" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s-p0" value="press_time = 0&lt;br&gt;long_done = 0" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="50.0" y="710" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s-d4" value="long_done == 0?&lt;br&gt;（3秒未満で離した）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="720" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s-d5" value="mode == 0?&lt;br&gt;（短押し有効）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="840" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s-sinc" value="short_cnt++" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="960" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s-d6" value="short_cnt &gt;= 2?" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="1040" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s-sflag" value="short_cnt = 0&lt;br&gt;short_flag = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="1160" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s-d7" value="sw_state == 1 かつ&lt;br&gt;long_done == 0?&lt;br&gt;（押している最中）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="300.0" y="1280" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s-tinc" value="press_time++" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="1410" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s-d8" value="press_time &gt;= 300?&lt;br&gt;（3秒）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="1490" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s-lflag" value="long_done = 1&lt;br&gt;long_flag = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="1610" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s-d9" value="mode == 1?&lt;br&gt;（点滅中？）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
