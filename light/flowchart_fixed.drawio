          <mxGeometry x="330.0" y="330" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f-n-m_port" value="ポート初期化&lt;br&gt;LED1〜LED3：出力（全消灯）&lt;br&gt;スイッチ：入力" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="270.0" y="410" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f-n-m_var" value="変数の初期化（すべて 0）&lt;br&gt;i、mode、blink_on&lt;br&gt;short_flag、long_flag、blink_flag&lt;br&gt;sw_state、sw_cnt、press_time、long_done&lt;br&gt;short_cnt、blink_cnt" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250.0" y="500" width="300" height="120" as="geometry" />
