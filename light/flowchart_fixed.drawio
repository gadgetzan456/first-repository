        </mxCell>
        <mxCell id="f-i_d8" value="press_time &gt;= 300?&lt;br&gt;（3秒）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="1880" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f-i_lflag" value="long_done = 1&lt;br&gt;long_flag = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="2000" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f-i_d9" value="mode == 1?&lt;br&gt;（点滅中）" style="html=1;shape=mxgraph.flowchart.decision;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
