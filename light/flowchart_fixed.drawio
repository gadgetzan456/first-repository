          <mxGeometry x="860" y="140" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="f-b10" value="short_flag（短押し2回）" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="910" y="138" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="f-b11" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="860" y="166" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="f-b12" value="long_flag（3秒長押し）" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="910" y="164" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="f-b13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="860" y="192" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="f-b14" value="blink_flag（0.5秒経過）" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="910" y="190" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="f-b15" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="860" y="218" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="f-b16" value="mode（main が書き、割り込みが読む）" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="910" y="216" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="f-b17" value="&lt;b&gt;- - - ▷&lt;/b&gt;　破線の矢印＝割り込みが立てた合図を main が受け取る（制御の流れではない）&lt;br&gt;同じ色の箱どうしが、同じ変数を書く／読む処理" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1240" y="140" width="440" height="100" as="geometry" />
        </mxCell>
