          <mxGeometry x="940" y="310" width="560" height="2350" as="geometry" />
        </mxCell>
        <mxCell id="f-b25" value="割り込みは main の&lt;br&gt;どの処理の途中でも&lt;br&gt;10ms ごとに入り、&lt;br&gt;終わると main の&lt;br&gt;続きに戻る" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="770" y="325" width="160" height="100" as="geometry" />
