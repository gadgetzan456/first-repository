        </mxCell>
        <mxCell id="f-b15" value="blink_flag（0.5秒経過）" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="790" y="190" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="f-b16" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
