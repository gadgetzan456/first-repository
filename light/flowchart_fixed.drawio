        <mxCell id="s-t34" value="&lt;b&gt;割り込みのポイント&lt;/b&gt;&lt;br&gt;&lt;br&gt;・1回の呼び出しでスイッチを1回だけ読み、待たずにすぐ終わる&lt;br&gt;・回数や時間は割り込みをまたいで数える&lt;br&gt;　（変数はグローバル。ローカル変数だと毎回 0 に戻る）&lt;br&gt;・短押しは「離した」と確定したときに判定する&lt;br&gt;・長押しは押している間に 3 秒（300 回）で判定する&lt;br&gt;・割り込みは LED を直接さわらず、黄色のフラグで main に合図する" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="850" y="100" width="380" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="変数一覧" id="page-2">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v-t1" value="&lt;b&gt;変数一覧&lt;/b&gt;（すべてグローバル変数。割り込みと main の両方から使う変数は C では volatile を付ける）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="760" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v-t2" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #666;padding:4px 8px;background:#e6e6e6;&quot;&gt;変数&lt;/th&gt;&lt;th style=&quot;border:1px solid #666;padding:4px 8px;background:#e6e6e6;&quot;&gt;値を書く側&lt;/th&gt;&lt;th style=&quot;border:1px solid #666;padding:4px 8px;background:#e6e6e6;&quot;&gt;意味&lt;/th&gt;&lt;th style=&quot;border:1px solid #666;padding:4px 8px;background:#e6e6e6;&quot;&gt;初期値&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;&lt;b&gt;sw_state&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;割り込み&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;スイッチの確定状態（1 = 押されている）&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot; align=&quot;center&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;&lt;b&gt;sw_cnt&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;割り込み&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;確定状態と違う値が続いた回数（3 で確定）&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot; align=&quot;center&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;&lt;b&gt;press_time&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;割り込み&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;押している時間（10ms 単位、300 = 3秒）&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot; align=&quot;center&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;&lt;b&gt;long_done&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;割り込み&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;今回の押下で長押しを判定済みか&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot; align=&quot;center&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;&lt;b&gt;short_cnt&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;割り込み&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;短押しの回数（2 回で short_flag を立てる）&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot; align=&quot;center&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;&lt;b&gt;blink_cnt&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;割り込み&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;点滅用の時間（10ms 単位、50 = 0.5秒）&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot; align=&quot;center&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;&lt;b&gt;short_flag&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;割り込み → main&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;短押し2回の合図。main が処理後 0 に戻す&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot; align=&quot;center&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;&lt;b&gt;long_flag&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;割り込み → main&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;3秒長押しの合図。main が処理後 0 に戻す&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot; align=&quot;center&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;&lt;b&gt;blink_flag&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;割り込み → main&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;0.5秒経過の合図。main が処理後 0 に戻す&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot; align=&quot;center&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;&lt;b&gt;i&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;main&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;次に点けるLEDの番号（0〜2、3 = LED3 点灯中）&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot; align=&quot;center&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;&lt;b&gt;mode&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;main（割り込みも読む）&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;0 = 通常、1 = 点滅（短押し無効）&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot; align=&quot;center&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;&lt;b&gt;blink_on&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;main&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;点滅の今の状態（1 = 点灯）&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot; align=&quot;center&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;&lt;b&gt;LED[0]〜LED[2]&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;main&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot;&gt;LED1〜LED3 の出力（1 = 点灯）&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;&quot; align=&quot;center&quot;&gt;0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1">
