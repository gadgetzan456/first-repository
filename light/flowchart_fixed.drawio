    </mxGraphModel>
  </diagram>
  <diagram name="動作トレース" id="page-2">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t-b1" value="&lt;b style=&quot;font-size:18px&quot;&gt;動作トレース&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t-b2" value="このフローチャートを C にそのまま書き写した flow_check.c を動かし、実際に出た記録です。操作：短押し（200ms）を8回 → 点滅中に短押し1回 → 3.5秒押し続けて離す。時刻は最初に押してからの ms。LED は左から LED1・LED2・LED3（● 点灯）。main の行は黄色。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t-b3" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #666;padding:4px 8px;background:#e6e6e6;text-align:left;&quot;&gt;時刻(ms)&lt;/th&gt;&lt;th style=&quot;border:1px solid #666;padding:4px 8px;background:#e6e6e6;text-align:left;&quot;&gt;10ms タイマ割り込み&lt;/th&gt;&lt;th style=&quot;border:1px solid #666;padding:4px 8px;background:#e6e6e6;text-align:left;&quot;&gt;main&lt;/th&gt;&lt;th style=&quot;border:1px solid #666;padding:4px 8px;background:#e6e6e6;text-align:left;&quot;&gt;LED&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;vertical-align:top;width:60px;&quot;&gt;20&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;vertical-align:top;width:430px;&quot;&gt;押下が確定（sw_state = 1）&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;vertical-align:top;width:430px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;vertical-align:top;width:80px;&quot;&gt;○　○　○&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;vertical-align:top;width:60px;&quot;&gt;220&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;vertical-align:top;width:430px;&quot;&gt;離したことが確定（sw_state = 0、押下時間 200ms）&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;vertical-align:top;width:430px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;vertical-align:top;width:80px;&quot;&gt;○　○　○&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;vertical-align:top;width:60px;&quot;&gt;220&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;vertical-align:top;width:430px;&quot;&gt;短押し → short_cnt = 1&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;vertical-align:top;width:430px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #666;padding:4px 8px;verti