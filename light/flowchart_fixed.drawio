        <mxCell id="f-b23" value="&lt;b&gt;10ms タイマ割り込み&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
