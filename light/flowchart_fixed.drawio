        </mxCell>
        <mxCell id="s-e9" value="3秒長押し&lt;br&gt;全消灯・短押し有効に戻る" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s-bl" target="s-off">
          <mxGeometry relative="1" as="geometry" x="0">
            <Array as="points">
              <mxPoint x="220" y="510" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s-b10" value="&lt;b&gt;状態が変わらない操作&lt;/b&gt;&lt;br&gt;・点滅中の短押し：数えない（無視）&lt;br&gt;・点滅していないときの長押し：何もしない&lt;br&gt;・短押し1回だけ：回数を覚えておき、次の1回で進む&lt;br&gt;&lt;br&gt;&lt;b&gt;i と mode の値で状態が決まる&lt;/b&gt;&lt;br&gt;フローチャートの変数がどの状態に当たるかを、各箱の下段に書いています。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="20" y="600" width="560" height="160" as="geometry" />
